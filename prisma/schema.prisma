generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A single interception: user tried to send a prompt containing PII to an AI site
model InterceptEvent {
  id         String   @id @default(cuid())
  clientId   String?  @unique // dedupe id generated by the extension
  createdAt  DateTime @default(now())
  site       String // e.g. chatgpt.com, claude.ai
  url        String?
  action     String // masked | sent_anyway | cancelled
  totalPii   Int      @default(0)
  severity   String   @default("low") // highest severity present: critical | high | medium | low
  items      String   @default("[]") // JSON: [{type,label,severity,count,samples[]}]
  maskedText String? // final masked prompt (truncated)
  source     String   @default("extension") // extension | demo
}
